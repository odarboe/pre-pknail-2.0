<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>{6086EE56-9863-4445-91F5-B423FE6D4C71}</ProjectGuid>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Json</RootNamespace>
    <AssemblyName>Json</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- 'Evaluation' is the Release-quality, licence-bypassed config used for third-party review
       (see PKNailForRevit.csproj). The SDK only turns on optimization for a config literally named
       'Release', so opt in explicitly here. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Evaluation'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Exclude legacy Properties\AssemblyInfo.cs — root AssemblyInfo.cs (T4) is the active one -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>