          ReadOnly="yes"
          Source="..\PKNailForRevit\RevitFiles\Imperial\PKNailProForRevit.rte" />
      </Component>
    </DirectoryRef>
    
    <DirectoryRef Id="REVIT_METRIC_TEMPLATES_LOCATION_RVT">
      <Component Id="PKNailProForRevitMetric_rte_RVT" Guid="456F96CD-1E42-456B-B1BD-CD43D1A06F9F">
