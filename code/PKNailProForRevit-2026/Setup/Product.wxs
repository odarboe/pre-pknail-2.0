<?xml version="1.0" encoding="UTF-8"?>
<Wix
  xmlns="http://schemas.microsoft.com/wix/2006/wi"
  xmlns:util="http://schemas.microsoft.com/wix/UtilExtension" >

  <?define ProductDisplayVersion = "2.0" ?>

  <?define ProductRevitVersion = "2026" ?>
  <!-- The upgrade code must be changed when the Revit version changes -->
  <!-- This allows version upgrades within a Revit version while still -->
  <!-- allowing multiple installations for different Revit versions -->
  <!-- New for Revit 2026 / PKNAIL 2.0 (2017 used 298D74F9-81D5-4451-AE10-C80193D34D9E) -->
  <?define ProductUpgradeCode = "08CC9F0C-7A4A-4C66-8D55-28A1D2A56F4E" ?>

  <?define ProductNameBase = "PKNail Pro For Revit" ?>
  <?define ProductName = "$(var.ProductNameBase) $(var.ProductRevitVersion)" ?>
  <?define ProductDisplayName = "$(var.ProductName) v$(var.ProductDisplayVersion) (64 bit)" ?>
  <?define ProductVendor = "PointKnown LLC" ?>
  <?define ProductVendorFolderName = "PointKnown" ?>
  <?define ProductLicenseFolderName = "license" ?>  
  <?define ProductEULAFileBase = "PKNailProForRevitEULA" ?>
  <?define ProductUserManualFileName = "PKNailProForRevitUserManual.pdf"?>  
  <?define ProductRTFExt = "rtf" ?>
  <?define ProductPDFExt = "pdf" ?>
  <?define ProductEULARTFFileName = "$(var.ProductEULAFileBase).$(var.ProductRTFExt)" ?>
  <?define ProductEULARTFFileID = "$(var.ProductEULAFileBase)_$(var.ProductRTFExt)" ?>
  <?define ProductEULAPDFFileName = "$(var.ProductEULAFileBase).$(var.ProductPDFExt)" ?>
  <?define ProductEULAPDFFileID = "$(var.ProductEULAFileBase)_$(var.ProductPDFExt)" ?>

  <Product
    Id="*"
    Name="$(var.ProductDisplayName)"
    Language="1033"
    Version="!(bind.FileVersion.PKNailForRevit_dll)"
    Manufacturer="$(var.ProductVendor)"
    UpgradeCode="$(var.ProductUpgradeCode)">

    <Package
      InstallerVersion="200"
      Compressed="yes"  
      Manufacturer="$(var.ProductVendor)" />

    <Upgrade Id="$(var.ProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="yes"
        Property="NEWERVERSIONDETECTED"
        Minimum="!(bind.FileVersion.PKNailForRevit_dll)" IncludeMinimum="no" />
      
      <UpgradeVersion
        OnlyDetect="no"
        Property="OLDERVERSIONBEINGUPGRADED"
        Minimum="1.0.0" IncludeMinimum="yes"
        Maximum="!(bind.FileVersion.PKNailForRevit_dll)" IncludeMaximum="no" />
    </Upgrade>

    <Condition Message="Can't downgrade to an earlier version from this installer.  To downgrade, uninstall the existing version, then run this installer again.">
      NOT NEWERVERSIONDETECTED      
    </Condition>

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

    <Property Id="ALLUSERS">1</Property>

    <Binary Id="CustomActions" SourceFile="..\SetupCA\bin\$(var.Configuration)\SetupCA.CA.dll" />
    
    <CustomAction
      Id="GetRevitEdition"
      BinaryKey="CustomActions"
      DllEntry="GetRevitEdition"
      Execute="immediate"
      Return="check" />
    
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProductEULARTFFileName)"/>
    <WixVariable Id="WixUIDialogBmp" Value="Bitmaps\dlgbmp.bmp" Overridable="no"/>
    <WixVariable Id="WixUIBannerBmp" Value="Bitmaps\bannrbmp.bmp" Overridable="no"/>

	<Directory Id="TARGETDIR" Name="SourceDir">
      
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="ProductVendorFolder" Name="$(var.ProductVendorFolderName)">
          <Directory Id="INSTALL_LOCATION" Name="$(var.ProductName)">
            <Directory Id="DOC_LOCATION" Name="doc" />
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
          <Directory Id="ProductStartMenuLocation" Name="$(var.ProductName)" />
      </Directory>      

      <Directory Id="CommonAppDataFolder">

        <Directory Id="VENDOR_COMMON_APPDATADIR_LOCATION" Name="$(var.ProductVendorFolderName)">
          <Directory Id="PRODUCT_COMMON_APPDATADIR_LOCATION" Name="$(var.ProductName)">
            <Directory Id="MY_REVIT_FILES_ROOT_LOCATION" Name="Libraries">
              <Directory Id="MY_REVIT_FILES_IMPERIAL_LOCATION" Name="US Imperial" />
              <Directory Id="MY_REVIT_FILES_METRIC_LOCATION" Name="US Metric" />
            </Directory>  
          </Directory>              
        </Directory>

        <Directory Id="Autodesk" Name="Autodesk">
          <Directory Id="Revit" Name="Revit">
            <Directory Id="Addins" Name="Addins">
              <Directory Id="ADDIN_MANIFEST_LOCATION" Name="$(var.ProductRevitVersion)" />
            </Directory>
          </Directory>

          <Directory Id="RAC_$(var.ProductRevitVersion)" Name="RAC $(var.ProductRevitVersion)">
            <Directory Id="RevitTemplates_RAC" Name="Templates">
              <Directory Id="REVIT_IMPERIAL_TEMPLATES_LOCATION_RAC" Name="US Imperial" />
              <Directory Id="REVIT_METRIC_TEMPLATES_LOCATION_RAC" Name="US Metric" />
            </Directory>
          </Directory>
          <Directory Id="RVT_$(var.ProductRevitVersion)" Name="RVT $(var.ProductRevitVersion)">
            <Directory Id="RevitTemplates_RVT" Name="Templates">
              <Directory Id="REVIT_IMPERIAL_TEMPLATES_LOCATION_RVT" Name="US Imperial" />
              <Directory Id="REVIT_METRIC_TEMPLATES_LOCATION_RVT" Name="US Metric" />
            </Directory>
          </Directory>
          
        </Directory>
      </Directory>
    </Directory>
    
    <DirectoryRef Id="INSTALL_LOCATION">
      
      <Component Id="Json_dll" Guid="D548BFB5-5EBD-4142-BDB7-6BD17AC16DFF">
        <File
          Id="Json_dll"
          Name="Json.dll"
          DiskId="1"
          Source="..\Json\bin\$(var.Configuration)\Json.dll" />
      </Component>
      
      <Component Id="PKNailForRevit_dll" Guid="92EE0DB3-D7D6-46A5-AE54-B0C48431ADBF">
        <File
          Id="PKNailForRevit_dll"
          Name="PKNailForRevit.dll"
          DiskId="1"
          Source="..\PKNailForRevit\bin\$(var.Configuration)\PKNailForRevit.dll" />
      </Component>

      <Component Id="PLUSManaged_dll" Guid="1FA9C981-409C-4D7C-8678-D5D2F73B0946">
        <File
          Id="PLUSManaged_dll"
          Name="PLUSManaged.dll"
          DiskId="1"
          Source="..\PKNailForRevit\bin\$(var.Configuration)\PLUSManaged.dll" />
      </Component>

      <Component Id="NewtonsoftJson_dll" Guid="FA7B55C5-D7C4-4D77-AFC9-C01AEF45CDF4">
        <File
          Id="NewtonsoftJson_dll"
          Name="Newtonsoft.Json.dll"
          DiskId="1"
          Source="..\PKNailForRevit\bin\$(var.Configuration)\Newtonsoft.Json.dll" />
      </Component>

      <!-- PKNAIL 2.0: the Revit-free AI-import library the plugin now depends on. Without this the
           installed plugin fails to load (missing PKNail.AiImport). Copied into PKNailForRevit's bin
           by the ProjectReference, so it is sourced from the same folder as the other dependencies. -->
      <Component Id="PKNailAiImport_dll" Guid="2A7914ED-6690-49EB-89CC-5612CE4C379F">
        <File
          Id="PKNailAiImport_dll"
          Name="PKNail.AiImport.dll"
          DiskId="1"
          Source="..\PKNailForRevit\bin\$(var.Configuration)\PKNail.AiImport.dll" />
      </Component>

      <Component Id="$(var.ProductEULAPDFFileID)" Guid="0315FB87-EA50-45AC-AACF-7BF4C7E008D8">
        <File
          Id="$(var.ProductEULAPDFFileID)"
          Name="$(var.ProductEULAPDFFileName)"
          DiskId="1"
          ReadOnly="yes"
          Source="$(var.ProductEULAPDFFileName)" />
      </Component>
      
    </DirectoryRef>

    <DirectoryRef Id="DOC_LOCATION">
      <Component Id="UserManual" Guid="DEB25ED6-B4B9-4FDB-906D-3232705073D5">
        <File
          Id="UserManual"
          Name="$(var.ProductUserManualFileName)"
          DiskId="1"
          ReadOnly="yes"
          Source="$(var.ProductUserManualFileName)" />
      </Component>
    </DirectoryRef>    

    <DirectoryRef Id="ProductStartMenuLocation">
      <Component Id="StartMenuShortcuts" Guid="C6CBC6CA-ECCD-4FDB-936C-823C1DE38C3C" >
        <Shortcut
          Id="UserManualShortcut"
          Name="User Manual"
          Target="[DOC_LOCATION]$(var.ProductUserManualFileName)"
          Description="$(var.ProductName) User Manual (pdf)"
          Show="normal" />
        <Shortcut
          Id="FamiliesShortcut"
          Name="Family Library"
          Target="[MY_REVIT_FILES_ROOT_LOCATION]"
          Description="Open the folder containing Revit families for PKNail"
          Show="normal" />
        <Shortcut
          Id="UninstallShortcut"
          Name="Uninstall $(var.ProductName)"
          Target="[System64Folder]msiexec.exe"
          Arguments="/x [ProductCode]"
          Description="Uninstalls $(var.ProductName)" />
        <RemoveFolder Id="ProductStartMenuLocation" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\PointKnown\PKNailProForRevit\$(var.ProductRevitVersion)"
          Name="InstalledStartMenuShortcuts"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ADDIN_MANIFEST_LOCATION">
      <Component Id="PKNailProForRevit_addin" Guid="282E9942-A62A-42A7-8CF1-5178346AE8C4">
        <File
          Id="PKNailProForRevit_addin"
          Name="PKNailProForRevit.addin"
          DiskId="1"
          Source="PKNailProForRevit.addin.template" />
        <util:XmlFile
          Id="SetAssemblyLocation"
          File="[ADDIN_MANIFEST_LOCATION]PKNailProForRevit.addin"
          ElementPath="//RevitAddIns/AddIn/Assembly"
          Action="setValue"
          Value="[INSTALL_LOCATION]PKNailForRevit.dll"
          Sequence="1" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="VENDOR_COMMON_APPDATADIR_LOCATION">
      <Directory Id="LicenseFolder" Name="$(var.ProductLicenseFolderName)">
        <Component Id="LicenseFolder" Guid="C84A6C41-430E-4823-892A-AC01FFE879FE">
          <CreateFolder>
            <util:PermissionEx User="Everyone" Delete="no" DeleteChild="no"/>            
          </CreateFolder>
        </Component>
      </Directory>
    </DirectoryRef>

    <DirectoryRef Id="REVIT_IMPERIAL_TEMPLATES_LOCATION_RAC">
      <Component Id="PKNailProForRevitImperial_rte_RAC" Guid="884F33C9-1747-4F46-9AC3-0DFAB4A4A524">
        <Condition>REVIT_EDITION_LABEL = "RAC"</Condition>
        <File
          Id="PKNailProForRevitImperial_rte_RAC"
          Name="PKNailProForRevit.rte"
          DiskId="1"
          ReadOnly="yes"
          Source="..\PKNailForRevit\RevitFiles\Imperial\PKNailProForRevit.rte" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="REVIT_METRIC_TEMPLATES_LOCATION_RAC">
      <Component Id="PKNailProForRevitMetric_rte_RAC" Guid="6CD46C12-94C8-43E7-A9A0-A5EF6AA9EE9C">
