    </DirectoryRef>

    <DirectoryRef Id="REVIT_IMPERIAL_TEMPLATES_LOCATION_RVT">
      <Component Id="PKNailProForRevitImperial_rte_RVT" Guid="0AA79705-2762-4B6C-AB80-5E243E233C53">
