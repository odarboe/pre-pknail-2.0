<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>3.0</ProductVersion>
    <ProjectGuid>{186154f0-0756-4228-8f8e-d628995e5616}</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>PKNailProForRevit2017</OutputName>
    <OutputType>Package</OutputType>
    <WixToolPath>..\Tools\Wix\bin\</WixToolPath>
    <WixTargetsPath>$(WixToolPath)wix.targets</WixTargetsPath>
    <WixTasksPath>wixtasks.dll</WixTasksPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
    <InstallerPlatform>x86</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Deploy|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\Deploy\</IntermediateOutputPath>
    <InstallerPlatform>x86</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Deploy64|x64' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\Deploy64\</IntermediateOutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressAllWarnings>False</SuppressAllWarnings>
    <Pedantic>False</Pedantic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Bitmaps\bannrbmp.bmp" />
    <Content Include="Bitmaps\dlgbmp.bmp" />
    <Content Include="bootstrapper\configuration.xml" />
    <Content Include="bootstrapper\signSetup.bat" />
    <Content Include="PKNailProForRevit.addin.template" />
    <Content Include="PKNailProForRevitEULA.pdf" />
    <Content Include="PKNailProForRevitEULA.rtf" />
    <Content Include="PKNailProForRevitUserManual.pdf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SetupCA\SetupCA.csproj">
      <Name>SetupCA</Name>
      <Project>{156a68d0-4a66-4171-bc70-8c2d56273a16}</Project>
      <Private>True</Private>
      <DoNotHarvest>True</DoNotHarvest>
      <RefProjectOutputGroups>Binaries;Content;Satellites</RefProjectOutputGroups>
      <RefTargetDir>INSTALLLOCATION</RefTargetDir>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Bitmaps" />
    <Folder Include="bootstrapper" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixUtilExtension">
      <HintPath>..\Tools\Wix\bin\WixUtilExtension.dll</HintPath>
      <Name>WixUtilExtension</Name>
    </WixExtension>
    <WixExtension Include="WixUIExtension">
      <HintPath>..\Tools\Wix\bin\WixUIExtension.dll</HintPath>
      <Name>WixUIExtension</Name>
    </WixExtension>
  </ItemGroup>
  <Import Project="$(WixTargetsPath)" />
  <!--
	To modify your build process, add your task inside one of the targets below and uncomment it.
	Other similar extension points exist, see Wix.targets.
	<Target Name="BeforeBuild">
	</Target>
	-->
  <Target Name="AfterBuild">
    <GetAssemblyIdentity AssemblyFiles="..\PKNailForRevit\bin\$(Configuration)\PKNailForRevit.dll">
      <Output TaskParameter="Assemblies" ItemName="AssemblyVersion" />
    </GetAssemblyIdentity>
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFiles="$(TargetDir)$(TargetName)_$(PlatformName)$(TargetExt)" />
    <Delete Files="$(TargetDir)$(TargetFileName)" />
    <Exec Condition=" '$(Platform)' == 'x64' " Command="..\Tools\dotNetInstaller\bin\InstallerLinker.exe /Embed+ /Template:..\Tools\dotNetInstaller\bin\dotNetInstaller.exe /Output:bootstrapper\$(TargetName)_v%(AssemblyVersion.Version)_setup.exe /Configuration:bootstrapper\configuration.xml" />
  </Target>
</Project>