<#
string projectDir = System.IO.Path.GetDirectoryName(this.Host.TemplateFile);
string solutionDir = System.IO.Directory.GetParent(projectDir).ToString();
string productInfoXml = System.IO.File.ReadAllText(solutionDir + @"\VersionInfo\ProductInfo.xml");
System.Xml.Linq.XDocument xmlDoc = System.Xml.Linq.XDocument.Parse(productInfoXml);

var productBaseName = xmlDoc.Root.Element(@"ProductBaseName").Value;
var productRevitVersion = xmlDoc.Root.Element(@"ProductRevitVersion").Value;
var productFolderName = xmlDoc.Root.Element(@"ProductFolderName").Value;
var productVendorURLBase = xmlDoc.Root.Element(@"ProductVendorURLBase").Value;
var productVendorSupportURLPath = xmlDoc.Root.Element(@"ProductVendorSupportURLPath").Value;
var productVendorLoginURLPath = xmlDoc.Root.Element(@"ProductVendorLoginURLPath").Value;
var productVendorESDURLPath = xmlDoc.Root.Element(@"ProductVendorESDURLPath").Value;
var productVendorPurchaseURLPath = xmlDoc.Root.Element(@"ProductVendorPurchaseURLPath").Value;
#>

//
// This file was autogenerated by T4; do not edit manually!
//

namespace PKNailForRevit
{
    internal static class ProductInfo
    {
        private const string m_urlBase = @"<#= productVendorURLBase #>";

        internal const string ProductBaseName = @"<#= productBaseName #>";
        internal const string ProductRevitVersion = @"<#= productRevitVersion #>";
        internal const string ProductName = ProductBaseName + @" " + ProductRevitVersion;

        internal const string ProductFolderName = @"<#= productFolderName #>" + ProductRevitVersion;

        internal const string ProductEsdUrlRoot = m_urlBase + @"<#= productVendorESDURLPath #>";
        internal const string ProductSupportUrlRoot = m_urlBase + @"<#= productVendorSupportURLPath #>";
        internal const string ProductLoginUrlRoot = m_urlBase + @"<#= productVendorLoginURLPath #>";
        internal const string ProductPurchaseUrlRoot = m_urlBase + @"<#= productVendorPurchaseURLPath #>";		

        internal static string GetUserVersion(string fullVersion)
        {
            System.Text.RegularExpressions.Regex versionExp = new System.Text.RegularExpressions.Regex(@"(\d+)\.(\d+)\.(\d+).(\d+)", System.Text.RegularExpressions.RegexOptions.Compiled);
            System.Text.RegularExpressions.Match versionMatch = versionExp.Match(fullVersion);
            return (versionMatch.Result(@"$1.$2"));
		}
    }
}