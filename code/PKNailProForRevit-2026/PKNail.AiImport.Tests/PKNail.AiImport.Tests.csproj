<Project Sdk="Microsoft.NET.Sdk">

  <!-- PKNAIL 2.0 fast unit-test gate (Epic 9a). net8.0, no Revit. Runs under `dotnet test`.
       Hosts the frozen JSON contract as a copied fixture for Epic 1+ tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PKNail.AiImport.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKNail.AiImport\PKNail.AiImport.csproj" />
  </ItemGroup>

  <!-- Frozen JSON contract v1 (single source of truth in docs/) linked as a test fixture (Epic 0 story 0.2). -->
  <ItemGroup>
    <None Include="..\..\..\docs\ai_engine_pknail_results.json"
          Link="Fixtures\ai_engine_pknail_results.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Known-good demo: clean 5x4 m room with correct interior angles; verified end-to-end in Revit 2026. -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.demo.json"
          Link="Fixtures\ai_engine_pknail_results.demo.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- v2 contract example: same room expressed with absolute wall endpoints. -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.v2.example.json"
          Link="Fixtures\ai_engine_pknail_results.v2.example.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Real v2 building: 9 independent absolute walls (multi-room, not a connected chain). -->
    <None Include="..\..\..\docs\new_final_combined_pknail.json"
          Link="Fixtures\new_final_combined_pknail.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Latest AI-engine exports, kept as a regression pair for the orthogonality guard:
         v4.0 carries ~0.11° near-square drift; v4.1 is the corrected, axis-aligned export. -->
    <None Include="..\..\..\docs\final_combined_pknail_v4.0_bug.json"
          Link="Fixtures\final_combined_pknail_v4.0_bug.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\final_combined_pknail_v4.1.json"
          Link="Fixtures\final_combined_pknail_v4.1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Epic 13: contract v2.1 example handed to the AI-engine team (docs/ai_engine_pknail_schema_v2.1.md). -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.v2.1.example.json"
          Link="Fixtures\ai_engine_pknail_results.v2.1.example.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Epic 13: the October 2026 AI-engine + manual-check exports (independent walls, T-junctions, no loop
         order). Direct Build must draw every wall and opening in each of them. -->
    <None Include="..\..\..\docs\October5\New\*.json"
          LinkBase="Fixtures\October5"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The run that failed in Revit on 2026-10-12 (doors narrower than the default family can build). -->
    <None Include="..\..\..\docs\October5\1_*.json"
          LinkBase="Fixtures\October5"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The 2026-11-06 Revit check: 4 sliding doors (FamilyDefIdx 4) + 3 hinged doors. Direct Build must
         carry the family index to Revit and hang the hinged doors on the jambs of the expected plan. -->
    <None Include="..\..\..\docs\October31\1_v2_ai_pknail_v2_doortypes.json"
          Link="Fixtures\October31\1_v2_ai_pknail_v2_doortypes.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
