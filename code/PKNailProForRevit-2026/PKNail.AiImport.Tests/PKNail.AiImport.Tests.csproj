<Project Sdk="Microsoft.NET.Sdk">

  <!-- PKNAIL 2.0 fast unit-test gate (Epic 9a). net8.0, no Revit. Runs under `dotnet test`.
       Hosts the frozen JSON contract as a copied fixture for Epic 1+ tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PKNail.AiImport.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKNail.AiImport\PKNail.AiImport.csproj" />
  </ItemGroup>

  <!-- Frozen JSON contract v1 (single source of truth in docs/) linked as a test fixture (Epic 0 story 0.2). -->
  <ItemGroup>
    <None Include="..\..\..\docs\ai_engine_pknail_results.json"
          Link="Fixtures\ai_engine_pknail_results.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Known-good demo: clean 5x4 m room with correct interior angles; verified end-to-end in Revit 2026. -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.demo.json"
          Link="Fixtures\ai_engine_pknail_results.demo.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- v2 contract example: same room expressed with absolute wall endpoints. -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.v2.example.json"
          Link="Fixtures\ai_engine_pknail_results.v2.example.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Real v2 building: 9 independent absolute walls (multi-room, not a connected chain). -->
    <None Include="..\..\..\docs\new_final_combined_pknail.json"
          Link="Fixtures\new_final_combined_pknail.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Latest AI-engine exports, kept as a regression pair for the orthogonality guard:
         v4.0 carries ~0.11° near-square drift; v4.1 is the corrected, axis-aligned export. -->
    <None Include="..\..\..\docs\final_combined_pknail_v4.0_bug.json"
          Link="Fixtures\final_combined_pknail_v4.0_bug.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\final_combined_pknail_v4.1.json"
          Link="Fixtures\final_combined_pknail_v4.1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
