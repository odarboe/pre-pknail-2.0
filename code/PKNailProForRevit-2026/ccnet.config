<cruisecontrol xmlns:cb="urn:ccnet.config.builder">
  <project name="PKNailForRevit">
    <workingDirectory>C:\Documents and Settings\Mark\My Documents\PKNailForRevit-nightly\</workingDirectory>
    <artifactDirectory>C:\Documents and Settings\Mark\My Documents\PKNailForRevit-nightly-buildArtifacts\</artifactDirectory>
    <webURL>http://localhost/ccnet/server/local/project/PKNailForRevit/ViewLatestBuildReport.aspx</webURL>
    <modificationDelaySeconds>60</modificationDelaySeconds>
    <triggers>
      <scheduleTrigger name="nightly" time="23:30" buildCondition="IfModificationExists"></scheduleTrigger>
    </triggers>
    <sourcecontrol type="svn" username="mark" password="bayitn">
      <trunkUrl>http://svn.thegentlemancoder.com/pknail/PKNailForRevit/trunk/</trunkUrl>
      <executable>C:\Program Files\Collabnet\Subversion Client\svn.exe</executable>
    </sourcecontrol>
    <tasks>
      <msbuild>
        <description>Rebuild solution, Debug configuration</description>
        <executable>C:\Windows\Microsoft.NET\Framework\v3.5\MSBuild.exe</executable>
        <projectFile>PKNailForRevit.sln</projectFile>
        <targets>Rebuild</targets>
        <buildArgs>/noconsolelogger /p:Configuration=Debug</buildArgs>
        <logger>C:\Program Files\CruiseControl.NET\server\ThoughtWorks.CruiseControl.MsBuild.dll</logger>
      </msbuild>
      <msbuild>
        <description>Rebuild solution, Release configuration</description>
        <executable>C:\Windows\Microsoft.NET\Framework\v3.5\MSBuild.exe</executable>
        <projectFile>PKNailForRevit.sln</projectFile>
        <targets>Rebuild</targets>
        <buildArgs>/noconsolelogger /p:Configuration=Release</buildArgs>
        <logger>C:\Program Files\CruiseControl.NET\server\ThoughtWorks.CruiseControl.MsBuild.dll</logger>
      </msbuild>
      <nunit>
        <description>Json Unit tests</description>
        <path>C:\Program Files\NUnit 2.5.2\bin\net-2.0\nunit-console.exe</path>
        <assemblies>
          <assembly>C:\Documents and Settings\Mark\My Documents\PKNailForRevit-nightly\Json.UnitTests\bin\Debug\Json.UnitTests.dll</assembly>
        </assemblies>
        <outputfile>nunit-results-JsonUnitTests.xml</outputfile>
      </nunit>
      <nunit>
        <description>PKNail Unit tests</description>
        <path>C:\Program Files\NUnit 2.5.2\bin\net-2.0\nunit-console.exe</path>
        <assemblies>
          <assembly>C:\Documents and Settings\Mark\My Documents\PKNailForRevit-nightly\PKNailForRevit.UnitTests\bin\Debug\PKNailForRevit.UnitTests.dll</assembly>
        </assemblies>
        <excludedCategories>
          <excludedCategory>UsesRangefinder</excludedCategory>
        </excludedCategories>
        <outputfile>nunit-results-PKNailUnitTests.xml</outputfile>
      </nunit>
      <nunit>
        <description>PKNail Functional tests</description>
        <path>C:\Program Files\NUnit 2.5.2\bin\net-2.0\nunit-console.exe</path>
        <timeout>3600</timeout>
        <assemblies>
          <assembly>C:\Documents and Settings\Mark\My Documents\PKNailForRevit-nightly\PKNailForRevit.TestRunner\bin\Debug\PKNailForRevit.TestRunner.dll</assembly>
        </assemblies>
        <includedCategories>
          <includedCategory>RunOnBuildServer</includedCategory>
        </includedCategories>
        <outputfile>nunit-results-PKNailTestRunner.xml</outputfile>
      </nunit>
    </tasks>
    <publishers>
      <merge>
        <files>
          <file>nunit-results-JsonUnitTests.xml</file>
          <file>nunit-results-PKNailUnitTests.xml</file>
          <file>nunit-results-PKNailTestRunner.xml</file>
        </files>
      </merge>
      <xmllogger></xmllogger>
      <email from="buildmeister@thegentlemancoder.com" mailhost="smtp.mxes.net" mailhostUsername="mark@jacowag.net" mailhostPassword="bayitn">
        <users>
          <user name="mark" group="buildmaster" address="mark@jacowag.net"></user>
        </users>
        <groups>
          <group name="buildmaster">
            <notifications>
              <notificationType>Always</notificationType>
            </notifications>
          </group>
        </groups>
      </email>
    </publishers>
  </project>
</cruisecontrol>
