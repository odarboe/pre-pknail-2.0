<#
string projectDir = System.IO.Path.GetDirectoryName(this.Host.TemplateFile);
string solutionDir = System.IO.Directory.GetParent(projectDir).ToString();
string productInfoXml = System.IO.File.ReadAllText(solutionDir + @"\VersionInfo\ProductInfo.xml");
System.Xml.Linq.XDocument xmlDoc = System.Xml.Linq.XDocument.Parse(productInfoXml);

string productBaseName = (string)xmlDoc.Root.Element(@"ProductBaseName").Value;
string productFolderName = (string)xmlDoc.Root.Element(@"ProductFolderName").Value;
string productRevitVersion = (string)xmlDoc.Root.Element(@"ProductRevitVersion").Value;
string productName = productBaseName + " " + productRevitVersion;
string productVendorName = (string)xmlDoc.Root.Element(@"ProductVendorName").Value;
string productVendorURLBase = (string)xmlDoc.Root.Element(@"ProductVendorURLBase").Value;
string productThisYear = (string)xmlDoc.Root.Element(@"ProductThisYear").Value;
#>

