<Project Sdk="Microsoft.NET.Sdk">

  <!-- Epic 9b — in-process integration tests for the Epic 3 AiModelImporter bridge. Must target
       net8.0-windows because it references PKNailForRevit (net8.0-windows). A hand-rolled
       RecordingProjectModel fake stands in for the live RevitDocument; no Revit runtime is needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PKNail.AiImport.IntegrationTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKNailForRevit\PKNailForRevit.csproj" />
    <ProjectReference Include="..\PKNail.AiImport\PKNail.AiImport.csproj" />
  </ItemGroup>

  <!-- Frozen JSON contract v1 + the known-good demo, linked as copied fixtures. -->
  <ItemGroup>
    <None Include="..\..\..\docs\ai_engine_pknail_results.json"
          Link="Fixtures\ai_engine_pknail_results.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\ai_engine_pknail_results.demo.json"
          Link="Fixtures\ai_engine_pknail_results.demo.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\ai_engine_pknail_results.v2.example.json"
          Link="Fixtures\ai_engine_pknail_results.v2.example.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\new_final_combined_pknail.json"
          Link="Fixtures\new_final_combined_pknail.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Epic 13: contract v2.1 example handed to the AI-engine team (docs/ai_engine_pknail_schema_v2.1.md). -->
    <None Include="..\..\..\docs\ai_engine_pknail_results.v2.1.example.json"
          Link="Fixtures\ai_engine_pknail_results.v2.1.example.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Epic 13: the October 2026 AI-engine + manual-check exports (independent walls, T-junctions, no loop
         order). Direct Build must draw every wall and opening in each of them. -->
    <None Include="..\..\..\docs\October5\New\*.json"
          LinkBase="Fixtures\October5"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The run that failed in Revit on 2026-10-12 (doors narrower than the default family can build). -->
    <None Include="..\..\..\docs\October5\1_*.json"
          LinkBase="Fixtures\October5"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The 2026-11-06 Revit check: 4 sliding doors (FamilyDefIdx 4) + 3 hinged doors. Direct Build must
         carry the family index to Revit and hang the hinged doors on the jambs of the expected plan. -->
    <None Include="..\..\..\docs\October31\1_v2_ai_pknail_v2_doortypes.json"
          Link="Fixtures\October31\1_v2_ai_pknail_v2_doortypes.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
