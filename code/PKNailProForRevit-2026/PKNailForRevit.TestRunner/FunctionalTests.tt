<#+
void genTestMethods(string testDefsXml)
{
	System.Xml.Linq.XDocument XmlDoc = System.Xml.Linq.XDocument.Parse(testDefsXml);
	var tests = from c in XmlDoc.Descendants("Test") select new { name = c.Attribute("name").Value,
																  revitProjectFile = c.Element("RevitProjectFile").Value,
																  automationScriptFile = c.Element("AutomationScriptFile").Value,
																  referenceModelStateFile = c.Element("ReferenceModelStateFile").Value
																};

    foreach (var test in tests )
	{
#>
		[Test]
		public void Test_<#= test.name #>()
		{
			string testName = @"<#= test.name #>";
			string revitProjectFile = @"<#= test.revitProjectFile #>";
			string automationScriptFile = @"<#= test.automationScriptFile #>";
			string referenceModelStateFile = @"<#= test.referenceModelStateFile #>";

			runFunctionalTest(testName, revitProjectFile, automationScriptFile, referenceModelStateFile);
		}

<#+
	}
}
#>